@model IEnumerable<RaceDay.MVC.Models.ResultViewModel>

@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-4">
    <h2 class="mb-4">My Race Results</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Event</th>
                    <th>Position</th>
                    <th>Finish Time</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@(item.Enrolment?.Event?.Name ?? "N/A")</td>
                            <td><span class="badge bg-success fs-6">#@item.Position</span></td>
                            <td>@item.FinishTime.ToString(@"hh\:mm\:ss")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">No results recorded for your enrolments yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>