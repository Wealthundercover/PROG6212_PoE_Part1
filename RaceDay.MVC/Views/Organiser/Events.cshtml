@model IEnumerable<RaceDay.MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold">Manage Race Events</h2>
        <p class="text-muted mb-0">View, edit, or remove your registered race events.</p>
    </div>
    <a asp-action="CreateEvent" class="btn btn-success fw-bold">
        + Create Event
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Banner</th>
                        <th>Event Name</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Enrolments</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var ev in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    @if (!string.IsNullOrEmpty(ev.ImageUrl))
                                    {
                                        <img src="@ev.ImageUrl" class="rounded" width="50" height="35" style="object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No Banner</span>
                                    }
                                </td>
                                <td class="fw-bold">@ev.Name</td>
                                <td>@ev.Date.ToString("yyyy-MM-dd")</td>
                                <td>@ev.Location</td>
                                <td>
                                    <span class="badge bg-info text-dark">@ev.EnrolledCount / @ev.MaxCapacity</span>
                                </td>
                                <td>
                                    <span class="badge @(ev.Status == "Upcoming" ? "bg-success" : "bg-secondary")">
                                        @ev.Status
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="Edit" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <em>No events found. Click "+ Create Event" to add your first race!</em>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>